# x-mcp-ai environment (see docs/02 §4 — the canonical env-var table).
# Load with:  node --env-file=.env build/src/index.js   (no dotenv dependency).
# Copy to .env and fill in. .env is git-ignored.

# --- Auth ---
X_MCP_AUTH_MODE=oauth2                # oauth2 | app-only
X_MCP_CLIENT_ID=
# X_MCP_CLIENT_SECRET=                # confidential clients only (PKCE public clients omit it)
# X_MCP_BEARER_TOKEN=                 # app-only mode
# X_MCP_TOKEN_FILE=                   # rotating OAuth2 token store (default: OS-resolved path)
# X_MCP_TOKEN_KEYCHAIN=0              # 1 = OS keychain instead of the token file (macOS/Linux;
                                      # mutually exclusive with an explicit X_MCP_TOKEN_FILE)

# --- Policy (two-axis; deny always wins) ---
X_MCP_POLICY=read-only                # read-only | engage | publish | manage | full
# X_MCP_POLICY_ALLOW=                 # comma-separated op:domain overrides
# X_MCP_POLICY_DENY=
# X_MCP_HIDE_DENIED=0                 # 1 → drop denied tools from registration entirely

# --- Cost (session credit budget, USD; operator space only) ---
# X_MCP_CREDIT_BUDGET=5.00
X_MCP_BUDGET_MODE=warn                # warn | hard

# --- Availability (gates only pilot/premium-user/enterprise registration) ---
# X_MCP_AVAILABILITY=app+user,user-only

# --- Media (required for uploads; every upload must realpath inside it) ---
# X_MCP_MEDIA_DIR=

# --- Multi-account ---
# X_MCP_PROFILES_FILE=
# X_MCP_PROFILE=                        # which named block of the profiles file to select

# --- Diagnostics ---
# X_MCP_TIMEOUT_MS=30000                # per-HTTP-request timeout
# X_MCP_LOG_LEVEL=info                  # silent | error | info | debug (stderr only)

# X_MCP_BASE_URL and X_MCP_ALLOW_INSECURE_BASE_URL are deliberately not listed here or in
# server.json: they are test/dev escape hatches, and offering "send credentialed traffic to
# an arbitrary host" as a routine setting is a footgun. See docs/04-security.md.
